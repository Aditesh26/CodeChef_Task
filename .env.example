# Local API settings (MariaDB installed on the host uses port 3307).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=the_last_seat
DB_USER=lastseat
DB_PASSWORD=change-me
RESERVATION_HOLD_SECONDS=300

# Docker Compose settings. The API container uses db:3306 internally;
# the database is published on 3308 so it does not collide with host MariaDB.
MARIADB_ROOT_PASSWORD=change-me-root
DOCKER_DB_PORT=3308
